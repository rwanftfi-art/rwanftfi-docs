{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "RWANFTFI",
  "logo": {
    "dark": "/logo/dark.png",
    "light": "/logo/light.png"
  },
  "favicon": "/favicon.png",
  "colors": {
    "primary": "#000000",
    "light": "#383838",
    "dark": "#FFFFFF"
  },
  "font": {
    "headings": {
      "family": "Georgia",
      "weight": 700
    },
    "body": {
      "family": "Inter"
    }
  },
  "topbarLinks": [
    {
      "name": "Website",
      "url": "https://rwanftfi.com"
    }
  ],
  "topbarCtaButton": {
    "name": "Launch App",
    "url": "https://app.rwanftfi.com"
  },
  "navigation": {
    "groups": [
      {
        "group": "Start Here",
        "pages": [
          "executive-summary",
          "vision"
        ]
      },
      {
        "group": "NFT Ecosystem",
        "pages": [
          "nft-ecosystem"
        ]
      },
      {
        "group": "Deflationary Asset (DA)",
        "pages": [
          "da-token-mechanics",
          "da-mining-farming",
          "da-selling-lending"
        ]
      },
      {
        "group": "Earning & Marketing",
        "pages": [
          "marketing-binary-tree",
          "marketing-rewards",
          "marketing-career-ranks"
        ]
      },
      {
        "group": "Architecture",
        "pages": [
          "architecture",
          "security"
        ]
      },
      {
        "group": "Governance",
        "pages": [
          "governance"
        ]
      },
      {
        "group": "Roadmap",
        "pages": [
          "roadmap"
        ]
      },
      {
        "group": "Resources",
        "pages": [
          "support",
          "partnerships",
          "legal",
          "glossary",
          "technical-reference"
        ]
      }
    ]
  },
  "footerSocials": {
    "website": "https://rwanftfi.com",
    "x": "https://x.com/rwanftfi",
    "facebook": "https://www.facebook.com/rwanftfi/",
    "instagram": "https://www.instagram.com/rwanftfi/"
  },
  "modeToggle": {
    "default": "dark"
  },
  "description": "Own Your Future.",
  "seo": {
    "indexing": "all"
  },
  "styling": {
    "latex": true
  },
  "icons": {
    "library": "fontawesome"
  },
  "i18n": {
    "defaultLocale": "en",
    "locales": [
      { "locale": "en", "name": "English" },
      { "locale": "ru", "name": "Русский" },
      { "locale": "es", "name": "Español" },
      { "locale": "ar", "name": "العربية" },
      { "locale": "zh", "name": "中文" }
    ]
  }
